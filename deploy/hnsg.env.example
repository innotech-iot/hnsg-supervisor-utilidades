HNSG_MODE=live
HNSG_DATA_DIR=/mnt/hnsg-ssd/hnsg-runtime
# Senha via /etc/hnsg/pgpass, 0600, propriedade do usuario hnsg.
DATABASE_URL=postgresql+psycopg://hnsg@127.0.0.1:5432/hnsg
PGPASSFILE=/etc/hnsg/pgpass
COOKIE_SECURE=true
POLL_SECONDS=2
HISTORY_SECONDS=10
STALE_SECONDS=15
HISTORY_DAYS=7
AGGREGATE_DAYS=365
REQUIRE_SSD_MOUNT=true
SSD_MOUNT=/mnt/hnsg-ssd
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30
