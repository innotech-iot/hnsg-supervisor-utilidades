# NÃO use demo com um banco de operação real.
HNSG_MODE=demo
DEMO_FULL=false
DEMO_SCENARIO=normal
DEMO_SEED_HOURS=3
HNSG_DATA_DIR=./runtime
# Vazio = SQLite por modo, somente desenvolvimento.
DATABASE_URL=
COOKIE_SECURE=false
POLL_SECONDS=2
HISTORY_SECONDS=10
STALE_SECONDS=15
HISTORY_DAYS=7
AGGREGATE_DAYS=365
# Senha é criada pelo inicializador; nunca colocar credenciais no Git.
BOOTSTRAP_PASSWORD=
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30
REQUIRE_SSD_MOUNT=false
SSD_MOUNT=/srv/hnsg
